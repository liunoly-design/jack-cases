[Unit]
Description=Jack Cases API
After=network.target

[Service]
Type=simple
User=jack-cases
Group=jack-cases
WorkingDirectory=/data/jack-cases/current
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOST=127.0.0.1
# OpenResty proxy_pass uses this exact peer; EnvironmentFile may override for another topology.
Environment=TRUSTED_PROXY_IPS=127.0.0.1
Environment=DATABASE_URL=/data/jack-cases/shared/jack-case.db
Environment=STORAGE_DIR=/data/jack-cases/shared/uploads
Environment=APP_ORIGIN=https://jack-cases.minapp.xin
Environment=DEPLOYED_COMMIT_FILE=/data/jack-cases/shared/DEPLOYED_COMMIT
EnvironmentFile=/data/jack-cases/shared/.env
ExecStart=/usr/bin/node /data/jack-cases/current/apps/api/dist/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/data/jack-cases/shared

[Install]
WantedBy=multi-user.target
