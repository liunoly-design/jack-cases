PORT=3001
DATABASE_URL=./storage/jack-case.db
STORAGE_DIR=./storage/uploads
APP_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-long-random-string
MAX_IMAGE_MB=10
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Persist separately in your secret manager; never commit the actual value.
API_KEY_ENCRYPTION_KEY=
# Default empty: ignore forwarding headers. Exact IPs only; proxies must overwrite/append X-Forwarded-For.
TRUSTED_PROXY_IPS=
# API listen interface (independent local acceptance may use 127.0.0.8)
HOST=127.0.0.1

# Per-IP attempts per 15 minutes (success and failure); account limits remain login 10 / register 5.
AUTH_LOGIN_IP_LIMIT=200
AUTH_REGISTER_IP_LIMIT=50
